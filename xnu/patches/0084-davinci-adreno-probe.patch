+/*
+ * Read-only first-stage probe for the Davinci Adreno 618.
+ *
+ * This only confirms that the GPU's DeviceTree nub reaches IOKit. It does
+ * not map or read GPU registers, change clocks or regulators, start the GMU,
+ * load firmware, or advertise an IOAcceleratorES/Metal device.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+
+class SweetAdrenoProbe : public IOService {
+	OSDeclareDefaultStructors(SweetAdrenoProbe);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetAdrenoProbe, IOService);
+
+bool
+SweetAdrenoProbe::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	IOLog("SWEET GPU: Adreno 618 DeviceTree nub detected (%s); probe-only, hardware untouched\n",
+	    provider != NULL ? provider->getName() : "no provider");
+	registerService();
+	return true;
+}
+#endif /* SWEET */
